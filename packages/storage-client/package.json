{
    "name": "@aicacia/storage-client",
    "version": "0.1.0",
    "description": "Aicacia storage WebSocket client",
    "type": "module",
    "module": "esm",
    "main": "esm",
    "types": "types",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./esm/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build:esm": "tsc --project tsconfig.json",
        "build:browser": "rolldown -c",
        "build": "pnpm run clean && pnpm run build:esm && pnpm run build:browser",
        "clean": "shx rm -rf esm browser types tsconfig.tsbuildinfo",
        "lint": "biome lint .",
        "format": "biome format .",
        "format:fix": "biome format --write .",
        "test": "vitest",
        "openapi": "node ../../scripts/generate-openapi-client.mjs storage",
        "postopenapi": "pnpm exec biome format --write src/generated"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.3",
        "@openapitools/openapi-generator-cli": "2.41",
        "rolldown": "^1.1.5",
        "shx": "^0.4.0",
        "typescript": "^5.9.3",
        "vitest": "4.1.10"
    }
}
