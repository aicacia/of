{
  "name": "@aicacia/idp-client",
  "version": "0.1.0",
  "description": "Aicacia Local First Identity Provider Client",
  "keywords": [
    "aicacia",
    "openid",
    "connect",
    "oidc",
    "client"
  ],
  "author": "Nathan Faucett",
  "license": "(MIT OR Apache-2.0)",
  "readmeFilename": "README.md",
  "type": "module",
  "module": "esm",
  "main": "esm",
  "types": "types",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:esm": "tsc",
    "build:browser": "rolldown -c",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:browser",
    "doc": "typedoc",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "coverage:html": "vitest --coverage --reporter=html",
    "clean": "shx rm -rf esm browser types .nyc_output coverage tsconfig.tsbuildinfo",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "preCommit": "pnpm run lint:fix && pnpm run coverage",
    "postopenapi": "pnpm format:fix",
    "openapi": "node ../../scripts/generate-openapi-client.mjs idp",
    "prepare": "husky"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run preCommit"
    }
  },
  "dependencies": {
    "eventemitter3": "^5.0.4"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@biomejs/biome": "^2.5.3",
    "@types/benchmark": "^2.1.5",
    "@vitest/coverage-v8": "^4.1.10",
    "benchmark": "^2.1.4",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "rolldown": "^1.1.5",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "vitest": "4.1.10",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "tslib": "2"
  }
}
